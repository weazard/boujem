-2065776133	<!doctype html>\r\n<html>\r\n\r\n<head>\r\n\r\n\t<title>Zachtronics Support</title>\r\n\t\r\n\t<script src='http://ajax.googleapis.com/ajax/libs/jquery/2.0.0/jquery.min.js'></script>\r\n\t\r\n    <style>\r\n    html, body, div, span, applet, object, iframe,\r\n    h1, h2, h3, h4, h5, h6, p, blockquote, pre,\r\n    a, abbr, acronym, address, big, cite, code,\r\n    del, dfn, em, img, ins, kbd, q, s, samp,\r\n    small, strike, strong, sub, sup, tt, var,\r\n    b, u, i, center,\r\n    dl, dt, dd, ol, ul, li,\r\n    fieldset, form, label, legend,\r\n    table, caption, tbody, tfoot, thead, tr, th, td,\r\n    article, aside, canvas, details, figcaption, figure, \r\n    footer, header, hgroup, menu, nav, section, summary,\r\n    time, mark, audio, video {\r\n\t    margin: 0;\r\n\t    padding: 0;\r\n\t    border: 0;\r\n\t    outline: 0;\r\n\t    font-size: 100%;\r\n\t    font: inherit;\r\n\t    vertical-align: baseline;\r\n    }\r\n    /* HTML5 display-role reset for older browsers */\r\n    article, aside, details, figcaption, figure, \r\n    footer, header, hgroup, menu, nav, section {\r\n\t    display: block;\r\n    }\r\n    body {\r\n\t    line-height: 1;\r\n    }\r\n    ol, ul {\r\n\t    list-style: none;\r\n    }\r\n    blockquote, q {\r\n\t    quotes: none;\r\n    }\r\n    blockquote:before, blockquote:after,\r\n    q:before, q:after {\r\n\t    content: '';\r\n\t    content: none;\r\n    }\r\n    ins {\r\n\t    text-decoration: none;\r\n    }\r\n    del {\r\n\t    text-decoration: line-through;\r\n    }\r\n\r\n    table {\r\n\t    border-collapse: collapse;\r\n\t    border-spacing: 0;\r\n    }\r\n    </style>\r\n\r\n    <style>\r\n    /*--------------------------------------------------------------\r\n    Body\r\n    ----------------------------------------------------------------*/\r\n    body {\r\n\t    background: #373737;\r\n\t    font-size: 100%;\r\n\t    font-family: Arial, Helvetica, sans-serif;\r\n\t    line-height: 1.5;\r\n    }\r\n\r\n    /*--------------------------------------------------------------\r\n    Basic typography\r\n    ----------------------------------------------------------------*/\r\n    h1, h2, h3 {\r\n\t    font-family: Arial, Hellovetica, sans-serif;\r\n\t    line-height: 1em;\r\n    }\r\n\r\n    h1 { font-size: 2em; }\r\n    h2 { font-size: 1.6em; }\r\n    h3 { font-size: 1.6em; }\r\n\r\n    em { font-style: italic; }\r\n    strong { font-weight: bold; }\r\n\r\n    p {\r\n\t    padding: 0.3em 0;\r\n    }\r\n\r\n    /* Links */\r\n\r\n    a { color: #e33533; text-decoration: none }\r\n\r\n    a:hover { text-decoration: underline }\r\n    /*--------------------------------------------------------------\r\n    Elements\r\n    ----------------------------------------------------------------*/\r\n\r\n    /* forms */ \r\n    input, textarea {\r\n\t    background: #fff9de;\r\n\t    border: 1px solid #a6a6a6;\r\n\t    border-radius: 5px;\r\n\t\t    -moz-border-radius: 5px;\r\n\t\t    -webkit-border-radius: 5px;\r\n\t    font-family: Arial, Helvetica, sans-serif;\t\t\r\n\t    font-size: 1.1em;\r\n\t    padding: 0.2em;\r\n\t    vertical-align: top;\t\r\n    }\r\n\r\n    input:focus, input:hover, textarea:focus, text-area:hover {\r\n\t    background: #fff;\r\n\t    border: 1px solid #e33533;\r\n\t    outline: none;\r\n    }\r\n\r\n    /* lists */\r\n    ul { list-style: none; margin-left: 1em; }\r\n    ul li { \r\n        list-style-type: disc;\r\n    }\r\n\r\n    /*--------------------------------------------------------------\r\n    Structure\r\n    ----------------------------------------------------------------*/\r\n    header, footer {\r\n\t    background: #373737;\t\r\n\t    color: #fff;\r\n    }\r\n\r\n    section {\tbackground: #e0e0e0;\r\n\t    border-radius: 5px;\r\n\t\t    -moz-border-radius: 5px;\r\n\t\t    -webkit-border-radius: 5px;\r\n\t    box-shadow: 1px 1px 1px rgba(0, 0, 0, 0.35);\t\t\r\n\t\t    -moz-box-shadow: 1px 1px 1px rgba(0, 0, 0, 0.35);\t\r\n\t\t    -webkit-box-shadow: 1px 1px 1px rgba(0, 0, 0,0.35);\r\n\t    margin: 1.25em auto;\r\n\t    padding: 0.6em;\r\n\t    width: 960px;\r\n    }\r\n\r\n    section:after {\r\n\t    content: '';\r\n\t    display: table;\r\n\t    clear: both;\r\n    }\r\n\r\n    #container {\r\n\t    background: #f2f2f2;\r\n    }\r\n\r\n    /* Header */\r\n\r\n    header { padding: 1em 0; }\r\n\r\n    header a {\r\n\t    margin: 0 auto;\r\n\t    padding: 0;\r\n\t    background: transparent url(data:image/gif;base64,) no-repeat 10px 0px;\r\n\t    display: block;\r\n\t    height: 80px;\r\n\t    width: 460px;\r\n\t    text-indent: -9999px;\r\n    }\r\n\r\n    header a:hover {\r\n\t    background: transparent url(data:image/gif;base64,) no-repeat 10px 0px;\r\n    }\r\n\r\n    /* Footer */\r\n\r\n    footer { \r\n\t    padding: 0.5em 0; \r\n\t    text-align: center;\t\r\n    }\r\n\r\n    footer a {\r\n\t    margin: 0 auto;\r\n\t    padding: 0;\r\n\t    display: block;\r\n\t    height: 20px;\r\n\t    width: 55px;\r\n\t    text-indent: -9999px;\t\r\n    }\r\n\r\n\r\n    /*--------------------------------------------------------------\r\n    Directions/Main content\r\n    ----------------------------------------------------------------*/\r\n\r\n    #welcome p{\r\n\t    padding-left: 10px;\r\n    }\r\n\r\n    #welcome h1 {\r\n\t    padding-top: 5px;\r\n\t    padding-left: 10px;\r\n    }\r\n\r\n    .step {}\r\n\r\n    .step h1 {\r\n\t    background: #373737;\r\n\t    border-radius: 200px;\r\n\t\t    -moz-border-radius: 200px;\r\n\t\t    -webkit-border-radius: 200px;\r\n\t    color: #fff;\r\n\t    display: inline-block;\t\r\n\t    font-weight: bold;\r\n\t    line-height: 1.2;\r\n\t    height: 40px;\r\n\t    width: 40px;\r\n\t    text-align: center;\r\n\t    text-shadow: 2px 1px 1px #666;\r\n    }\r\n\r\n    .step h2 { display: inline-block; padding-left: 9px; }\r\n\r\n    .step .directions { padding-left: 55px; }\t\r\n\r\n    /*--------------------------------------------------------------\r\n    Support Form\r\n    ----------------------------------------------------------------*/\r\n    #support-form {}\r\n    #support-form .form-element { padding: 0.5em 0; }\r\n    #support-form label { \r\n\t    display: inline-block;\t\r\n\t    font-weight: bold;\r\n\t    vertical-align: top;\r\n\t    width: 85px;\r\n    }\r\n\r\n    #support-form span.additional-info {\r\n    }\r\n\t\r\n    #support-form input{ \r\n\t    height: 20px;\r\n\t    width: 300px; \r\n    }\r\n\r\n    #support-form input#subject { width: 745px; }\r\n\t\r\n    #support-form textarea { \r\n\t    height: 200px; \r\n\t    width: 745px;\r\n    }\r\n\r\n    .readonly { background: #f7f7f7; }\r\n\r\n    .readonly:hover, .readyonly:focus {\r\n\t    background: #f7f7f7;\r\n\t    border: 1px solid #939393;\r\n    }\r\n\r\n    #expand { color: #e33533; }\r\n\r\n    #expand:hover { \r\n\t    color: #e33533;\r\n\t    text-decoration: underline;\r\n\t    cursor: hand;\r\n\t    cursor: pointer;\r\n    }\r\n\r\n    #support-form .technical-info {\r\n\t    background: #f7f7f7;\r\n\t    border: 1px solid #a6a6a6;\t\r\n\t    border-radius: 5px;\r\n\t\t    -moz-border-radius: 5px;\r\n\t\t    -webkit-border-radius: 5px;\r\n\t    display: inline-block;\r\n\t    padding: 0.2em 0.7em;\r\n\t    width: 730px;\r\n    }\r\n\r\n    #display-technical-info  {\r\n\t    font-family: Consolas, monaco, monospace;\r\n\t    overflow: auto;\r\n\t    border: none;\r\n\t    border-radius: none;\r\n\t    height: 350px;\r\n\t    width: 100%;\r\n    }\r\n\r\n    .add-info {\r\n\t    border-top: 1px solid #999;\r\n\t    font-size: 90%;\r\n\t    padding: 0.2em;\r\n\t    margin-bottom: 1em;\r\n    }\r\n\r\n    .included-data {\r\n\t    white-space: pre;\r\n\t    font-size: 80%;\r\n    }\r\n\r\n    #support-form  input.submit {\r\n\t    color: #fff;\r\n\t    display: block;\r\n\t    font-family: LeagueGothic, Impact, sans-serif;\r\n\t    font-size: 2.2em;\r\n\t    text-transform: uppercase;\r\n\t    text-shadow: 2px 2px 0 #333;\t\r\n\t    margin: 0.25em auto;\t\r\n\t    height: 60px;\r\n\t    width: 140px;\r\n\t    box-shadow: inset -2px -2px 1px rgba(0, 0, 0, 0.25);\r\n\t\t    -moz-box-shadow: inset -2px -2px 1px rgba(0, 0, 0, 0.25);\r\n\t\t    -webkit-box-shadow: inset -2px -2px 1px rgba(0, 0, 0, 0.25);\r\n\t    /* gradient! */\r\n\t    background: #aa0404; /* Old browsers */\r\n\t    background: -moz-linear-gradient(top, #aa0404 0%, #cc2e2e 50%, #aa0404 100%); /* FF3.6+ */\r\n\t    background: -webkit-gradient(linear, left top, left bottom, color-stop(0%,#aa0404), color-stop(50%,#cc2e2e), color-stop(100%,#aa0404)); /* Chrome,Safari4+ */\r\n\t    background: -webkit-linear-gradient(top, #aa0404 0%,#cc2e2e 50%,#aa0404 100%); /* Chrome10+,Safari5.1+ */\r\n\t    background: -o-linear-gradient(top, #aa0404 0%,#cc2e2e 50%,#aa0404 100%); /* Opera 11.10+ */\r\n\t    background: -ms-linear-gradient(top, #aa0404 0%,#cc2e2e 50%,#aa0404 100%); /* IE10+ */\r\n\t    background: linear-gradient(to bottom, #aa0404 0%,#cc2e2e 50%,#aa0404 100%); /* W3C */\r\n\t    filter: progid:DXImageTransform.Microsoft.gradient( startColorstr='#aa0404', endColorstr='#aa0404',GradientType=0 ); /* IE6-9 */\t\r\n    }\r\n\r\n    #support-form input.submit:hover {\r\n\t    box-shadow: inset 2px 2px 1px rgba(0, 0, 0, 0.5);\r\n\t\t    -moz-box-shadow: inset 2px 2px 1px rgba(0, 0, 0, 0.5);\r\n\t\t    -webkit-box-shadow: inset 2px 2px 1px rgba(0, 0, 0, 0.5);\r\n\t    position: relative;\r\n\t    top: 1px;\r\n\t    text-shadow: -2px -2px 0 #333;\r\n\t    cursor: hand;\r\n\t    cursor: pointer;\r\n    }\r\n    </style>\r\n\r\n</head>\r\n\r\n<body>\r\n\r\n\t<div id='container'>\r\n\t\r\n\t\t<header>\r\n\t\t\t<a href='http://www.zachtronics.com' class='zachtronics'></a>\r\n\t\t</header>\r\n\r\n\t\t<section id='welcome'>\r\n\t\t\t<h1>Oh no! It looks like your game crashed.</h1>\r\n\t\t\t<p>Follow these steps to get things back up and running!</p>\r\n\t\t</section>\r\n\r\n\t\t<section id='step-1' class='step'>\r\n\t\t\t<h1>1</h1>\r\n\t\t\t<h2>Launch the game again.</h2>\r\n\t\t\t<div class='directions'>\r\n\t\t\t\t<p>If this is the first time the game has crashed, close this page and launch the game again. Sometimes these things just happen!</p>\r\n\t\t\t</div>\r\n\t\t</section>\r\n\r\n        <section id='step-2' class='step'>\r\n\t\t\t<h1>2</h1>\r\n\t\t\t<h2>Check your antivirus software.</h2>\r\n\t\t\t<div class='directions'>\r\n\t\t\t\t<p>Lately we've been getting many reports of crashes caused by antivirus and anti-malware software blocking the game from either reading its files or saving to its save directory. Newer versions of Windows 10 will even sometimes block programs from saving to the My Documents folder. If you're running an antivirus or anti-malware program, please make sure that it's not the culprit by checking that program's logs and/or temporarily disabling it.</p>\r\n\t\t\t</div>\r\n\t\t</section>\r\n\r\n\t\t<section id='step-3' class='step'>\r\n\t\t\t<h1>3</h1>\r\n\t\t\t<h2>Update your video drivers and restart your computer.</h2>\r\n\t\t\t<div class='directions'>\r\n\t\t\t\t<p>Another thing to try before contacting us is to update your video drivers. Find your video card manufacturer in the list below, and then click either the link to the manual or automatic driver download page. After updating your drivers, be sure to restart your computer!</p>\r\n\t\t\t\t<ul>\r\n\t\t\t\t\t<li>NVIDIA (<a href='http://www.nvidia.com/Download/index.aspx'>Manual</a>, <a href='http://www.nvidia.com/Download/Scan.aspx'>Automatic</a>)</li>\r\n\t\t\t\t\t<li>AMD (<a href='http://support.amd.com/us/gpudownload/Pages/index.aspx'>Manual</a>, <a href='http://support.amd.com/us/gpudownload/windows/Pages/auto_detect.aspx'>Automatic</a>)</li>\r\n\t\t\t\t\t<li>Intel (<a href='https://downloadcenter.intel.com/default.aspx'>Manual</a>, <a href='http://www.intel.com/p/en_US/support/detect?iid=dc_iduu'>Automatic</a>)</li>\r\n\t\t\t\t</ul>\r\n\t\t\t</div>\r\n\t\t</section>\r\n\r\n\t\t<section id='step-4' class='step'>\r\n\t\t\t<h1>4</h1>\r\n\t\t\t<h2>If all else fails, ask Zach!</h2>\r\n\t\t\t<div class='directions'>\r\n\t\t\t\t<p>If the steps above haven't solved the problem, use the form below to email Zach. Fill in your email address in the 'from' field and then briefly describe what you were doing when the game crashed. The email will automatically include information about the crash, your system, and your save file.</p>\r\n\t\t\t\t<p>And yes, this form literally emails Zach directly. He'll get back to you as soon as possible!</p>\r\n\r\n\t\t\t\t<form id='support-form' action='http://support.zachtronics.com/submit' method='post'>\r\n\t\t\t\t\t<div class='form-element'>\r\n\t\t\t\t\t\t<label for='email'>To:</label>\r\n\t\t\t\t\t\t<input type='email' name='to' class='readonly' id='to'  value='zach@zachtronics.com' readonly />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class='form-element'>\r\n\t\t\t\t\t\t<label for='email'>From:</label>\r\n\t\t\t\t\t\t<input type='email' name='from' id='from' placeholder='Your email address' />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class='form-element'>\r\n\t\t\t\t\t\t<label for='subject'>Subject:</label>\r\n\t\t\t\t\t\t<input type='text' name='subject' class='readonly' id='subject' value='Crash report #REPLACE_TICKET_ID for REPLACE_GAME_TITLE' readonly />\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class='form-element'>\r\n\t\t\t\t\t\t<label for='message'>Details:</label>\r\n\t\t\t\t\t\t<textarea class='message' id='message' name='message' placeholder='Describe what you were doing when the game crashed.'></textarea>\r\n\t\t\t\t\t</div>\r\n\t\t\t\t\t<div class='form-element'>\r\n\t\t\t\t\t\t<label for='tech-info'>Attached:</label>\r\n\t\t\t\t\t\t<div class='technical-info'>\r\n\t\t\t\t\t\t\t<p id='expand'>Click here to view the attached information.</p>\r\n\t\t\t\t\t\t\t<div id='display-technical-info'>\r\n\t\t\t\t\t\t\t\t<div class='add-info'>\r\n\t\t\t\t\t\t\t\t\t<em>Attached Data:</em>\r\n\t\t\t\t\t\t\t\t\t<div class='included-data'><a href='REPLACE_ZIP_PATH'>REPLACE_GAME_IDENTIFIER-save-directory.zip</a></div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t\t<div class='add-info'>\r\n\t\t\t\t\t\t\t\t\t<em>Crash Info:</em>\r\n\t\t\t\t\t\t\t\t\t<div class='included-data'>REPLACE_REPORT_TEXT</div>\r\n\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t\t</div>\r\n\t\t\t\t\t\t</div>\r\n\t\t\t\t\t</div>\r\n\r\n\t\t\t\t\t<input type='hidden' name='ticket' id='ticket' value='REPLACE_TICKET_ID' />\r\n\t\t\t\t\t<input type='hidden' name='report' id='report' value='REPLACE_ZIP_DATA' />\r\n\t\t\t\t\t<input type='submit' value='Submit' class='submit' id='submit' />\r\n\t\t\t\t\t\r\n\t\t\t\t</form>\r\n\t\t\t</div>\r\n\t\t</section>\r\n\r\n\t\t<footer>\r\n\t\t\t<p><a href='http://www.zachtronics.com' class='zachtronics'></a></p>\r\n\t\t</footer>\r\n\t\t\r\n\t</div>\r\n\t\r\n\t<script>\r\n\t\t$('#display-technical-info').hide();\r\n\t\t\r\n\t\t$('#expand').click(function() {\r\n\t\t\t$('#display-technical-info').toggle('slow');\r\n\t\t});\r\n\t</script>\r\n\r\n</body>\r\n\r\n</html>
